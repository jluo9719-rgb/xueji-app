# 默认本地模式无需创建 .env，直接修改 config.yaml 即可。
# 本地覆盖项：系统环境变量优先于 .env，.env 优先于 YAML。
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b

# 仅 llm.provider: anthropic 时使用以下云端配置。
# 云端 key/base_url：Windows 凭据管理器优先，环境变量/.env 兜底。
# ANTHROPIC_API_KEY=your-key
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# LLM_MODEL=your-cloud-model

# 开启 tools.web_search_enabled 后需要配置；凭据管理器优先。
# SERPER_API_KEY=your-serper-key
