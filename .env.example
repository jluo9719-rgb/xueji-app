# Data storage root (isolated test directories can override this)
XUEJI_DATA_ROOT=./data

# Retrieval threshold (0-1 score)
EVIDENCE_MIN_SCORE=0.12

# LLM Provider: auto | gemini | anthropic | ollama
LLM_PROVIDER=auto

# Gemini API (Server-side via @google/genai)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# Anthropic Messages compatible API
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
LLM_MODEL=claude-sonnet-4-20250514

# Local Ollama configuration
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3:8b
